{
  "name": "team-finder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @team-finder/api --filter @team-finder/web dev",
    "dev:local": "node apps/api/scripts/dev-local.ts",
    "build": "pnpm --filter @team-finder/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "eval:ai": "pnpm --filter @team-finder/api eval:ai",
    "test:prepare": "pnpm --filter @team-finder/api exec node -e \"import('mongodb-memory-server').then(m => m.MongoBinary.getPath()).then(p => console.log(p))\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,yaml,yml,css,html}": "prettier --write"
  }
}
