PORT=3000
# Atlas connection string (replica set required for transactions). Leave empty to run without a DB,
# or use `pnpm dev:local` from the repo root for an in-memory replica set.
MONGODB_URI=
MONGODB_DB=team-finder
# Proxy hops allowed to set x-forwarded-for ("true", a hop count, or a list of addresses). Empty: none.
TRUST_PROXY=
# Optional: demo sandbox creations per client IP per minute (default 10; global limit is 3x).
DEMO_SESSIONS_PER_MINUTE=
# Optional: sign-up, login and invite requests per client IP per minute (default 10).
AUTH_REQUESTS_PER_MINUTE=
# Optional: AI-drafted teams. Set an Anthropic API key to enable (model defaults to claude-opus-5-5),
# or LLM_PROVIDER=fake for the deterministic stand-in used by tests. Without either the panel is disabled.
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=
# Optional: AI drafts per day across all sessions (default 300; the per-session limit is 5/min).
LLM_DAILY_CAP=
# Optional: set to false to turn off demo-only routes (POST /api/demo/race). Default on.
DEMO_ROUTES_ENABLED=
