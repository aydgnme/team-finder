PORT=3000
# Atlas connection string (replica set required for transactions). Leave empty to run without a DB,
# or use `pnpm dev:local` from the repo root for an in-memory replica set.
MONGODB_URI=
MONGODB_DB=team-finder
# Proxy hops allowed to set x-forwarded-for ("true", a hop count, or a list of addresses). Empty: none.
TRUST_PROXY=
# Optional: demo sandbox creations per client IP per minute (default 10; global limit is 3x).
DEMO_SESSIONS_PER_MINUTE=
